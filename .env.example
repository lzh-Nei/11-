# AIES dev环境变量模板 → 复制为 .env 后填真实值（.env已被.gitignore，红线4）
MYSQL_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# JWT签名密钥（必填）：HS512要求≥64字节；仅dev弱密钥可用，生产另行下发（S-14零明文）
JWT_SECRET=
OLLAMA_MODEL=qwen2.5:7b

# ---- 预留（W6+启用）----
